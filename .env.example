# --- Alpaca (paper trading + market data) ---
# Get free paper-trading keys at https://app.alpaca.markets  ->  API Keys (Paper)
ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key
ALPACA_PAPER=true

# --- Anthropic (the Analyst's brain) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
# Check https://platform.claude.com/docs/en/about-claude/models for the current model id
ANTHROPIC_MODEL=claude-sonnet-5

# --- Watchlist & thresholds ---
WATCHLIST=AAPL,NVDA,TSLA,SPY
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
VOLUME_SPIKE_MULT=2.5
SIGNAL_COOLDOWN_SECONDS=600

# --- Notifications ---
# Desktop popup on this machine (uses plyer; needs a notification daemon
# running — true on virtually all desktop Linux/macOS/Windows setups).
NOTIFY_DESKTOP=true

# Telegram message, so alerts reach your phone too. See README.md for how to
# create a bot with @BotFather and find your chat id — takes about 2 minutes.
NOTIFY_TELEGRAM=true
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# --- Risk Guardrail ---
# Halt everything for the day if equity drops this many percent below
# yesterday's close (stays halted for the rest of the day even if it recovers).
MAX_DAILY_LOSS_PCT=3.0
# Flag any single position worth more than this percent of total equity.
MAX_POSITION_PCT=20.0
# Ceiling on TOTAL invested capital, as a percent of equity. Without this the
# strategy keeps opening positions as more symbols go oversold; worst case is
# TRADE_SIZE_PCT x number of symbols in WATCHLIST. Sells are never blocked.
MAX_PORTFOLIO_PCT=50.0
# Close any position down this many percent, WITHOUT asking for confirmation.
# strategy.py only exits on RSI overbought, which a falling position never
# reaches, so nothing else cuts a loser. This is the one path that trades
# without your explicit yes — it can only close a position, never open one.
# Set to 0 to disable.
STOP_LOSS_PCT=5.0
# Below this equity, the Pattern Day Trader rule applies.
PDT_EQUITY_THRESHOLD=25000
# How often (seconds) the guardrail re-checks your Alpaca account. This also
# sets how fast STOP_LOSS_PCT can react: a breach is only seen on a poll, so
# this is the worst-case lag before a losing position is closed. 30s costs
# about 4 API calls/min against Alpaca's ~200/min limit.
RISK_CHECK_INTERVAL_SECONDS=30

# --- Execution (paper trading only — see README.md's Execution section) ---
# NOTIFY_TELEGRAM must be true above, with a valid bot token/chat id, or the
# Executor has no way to ask for your confirmation and will never trade.
# New-position size on a BUY, as % of equity. Kept well under MAX_POSITION_PCT.
TRADE_SIZE_PCT=5.0
# How long a trade proposal waits for your yes/no reply before expiring.
CONFIRMATION_TIMEOUT_SECONDS=300
CONFIRMATION_POLL_SECONDS=5
